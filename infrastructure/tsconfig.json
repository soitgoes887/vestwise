{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    // Must be set explicitly alongside "module". Pulumi's Node.js runtime injects
    // module/moduleResolution: "nodenext" and then spreads this file's options over
    // the top (see @pulumi/pulumi cmd/run/run.js). Setting only "module" leaves the
    // injected "moduleResolution": "nodenext" in place, which fails with TS5110.
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
